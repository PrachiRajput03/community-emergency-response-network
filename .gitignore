coverage/
.nyc_output/
jacoco.exec
test-output/
surefire-reports/
failsafe-reports/

# Performance metrics
benchmark-results/
load-test/results/

# ===== Miscellaneous =====

# Backup files
*.bak
*.backup
*.old

# Debug files
*.pid
*.seed
*.pid.lock

# Certificate files
*.pfx
*.jks
*.keystore
*.truststore

# ===== Keep Example Files =====

!.env.example
!docker-compose.example.yml
!application-example.properties

# ===== Project Specific =====

# Uploaded media
/uploads/
/media/
/profile-photos/
/emergency-images/

# Generated docs
docs/generated/
apidocs/

# Local configuration
local-config/
*.local.yml
*.local.properties

# Mobile build artifacts
*.apk
*.aab
*.ipa

mobile-app/app/release/
mobile-app/app/debug/

# Log aggregation archives
logs.zip
*.log.zip